// Override
_label > _root:
	textShadow:
		offsetX: 1
		offsetY: 1

_checkbox > _root:
	color:
		bg: #323337ff

_checkbox!hover:
	color:
		bg: #323337ff

_checkbox!click:
	color:
		bg: #323337ff

_gridlayout > _layout:
	size:
		minHeight: 0
		minWidth: 0

_collayout > _gridlayout:
	size:
		minHeight: 0
		minWidth: 0

_rowlayout > _gridlayout:
	size:
		minHeight: 0
		minWidth: 0

_scrollpane > _layout:
	size:
		minHeight: 0
		minWidth: 0

_fixed_anchorpane > _anchorpane:
	size:
		minHeight: 0
		minWidth: 0

button > _button:
	font:
		family: "bahiana_regular"

logo_text > _label:
	font:
		size: 42

title > _label:
	font:
		size: 72
		family: "rocks_g_regular"

menu_title > _label:
	font:
		size: 52
		family: "rocks_g_regular"
